@model RepairInputModel
@{ ViewData["Title"] = "Регистрация ремонта"; }<h1>Регистрация ремонта</h1><form method="post" class="card card-body col-lg-6">@Html.AntiForgeryToken()<input asp-for="VehicleId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Description" class="form-label required"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="mb-3"><label asp-for="Parts" class="form-label"></label><textarea asp-for="Parts" class="form-control"></textarea></div><div class="mb-3"><label asp-for="Cost" class="form-label"></label><input asp-for="Cost" class="form-control" /></div><button class="btn btn-danger">Перевести в ремонт</button> <a asp-action="Details" asp-route-id="@Model.VehicleId" class="btn btn-link">Отмена</a></form>
