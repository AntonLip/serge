@model List<Vehicle>
@{ ViewData["Title"] = "Автопарк"; }
<div class="page-header"><h1>Автопарк</h1>@if (User.IsInRole(AppRoles.Mechanic) || User.IsInRole(AppRoles.Administrator)) { <a asp-action="Create" class="btn btn-primary">Добавить технику</a> }</div>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select name="status" asp-items="ViewBag.Statuses" class="form-select"><option value="">Все состояния</option></select></div><div class="col-auto"><button class="btn btn-outline-secondary">Применить</button></div></form>
<div class="card table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Техника</th><th>Тип</th><th>Пробег / моточасы</th><th>Водитель</th><th>Следующее ТО</th><th>Состояние</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a><br /><strong>@item.RegistrationNumber</strong></td><td>@Display.Text(item.Type)</td><td>@item.Mileage.ToString("N0") км<br />@item.EngineHours.ToString("N0") ч</td><td>@item.Driver?.FullName</td><td>@(item.NextMaintenanceDate.HasValue ? Display.Date(item.NextMaintenanceDate.Value) : "—")</td><td><span class="badge @Display.Badge(item.Status)">@Display.Text(item.Status)</span></td></tr> }</tbody></table></div>
