@model Vehicle
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Name" class="form-label required">Название / модель</label><input asp-for="Name" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="RegistrationNumber" class="form-label required">Регистрационный номер</label><input asp-for="RegistrationNumber" class="form-control" /><span asp-validation-for="RegistrationNumber" class="text-danger"></span></div><div class="col-md-3 mb-3"><label asp-for="Type" class="form-label">Тип</label><select asp-for="Type" class="form-select"><option value="0">КДМ</option><option value="1">Самосвал</option><option value="2">Трактор</option><option value="3">Другая</option></select></div></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="Mileage" class="form-label">Пробег, км</label><input asp-for="Mileage" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="EngineHours" class="form-label">Моточасы</label><input asp-for="EngineHours" class="form-control" /></div><div class="col-md-4 mb-3"><label class="form-label">Закреплённый водитель</label><select asp-for="DriverId" asp-items="ViewBag.Drivers" class="form-select"><option value="">Не закреплён</option></select></div></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="NextMaintenanceDate" class="form-label">Следующее ТО, дата</label><input asp-for="NextMaintenanceDate" type="date" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="NextMaintenanceMileage" class="form-label">ТО на пробеге, км</label><input asp-for="NextMaintenanceMileage" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="NextMaintenanceEngineHours" class="form-label">ТО на моточасах</label><input asp-for="NextMaintenanceEngineHours" class="form-control" /></div></div>
