@model Vehicle
@{ ViewData["Title"] = Model.RegistrationNumber; var canEdit = User.IsInRole(AppRoles.Mechanic) || User.IsInRole(AppRoles.Administrator); }
<div class="page-header"><div><h1>@Model.Name <span class="badge @Display.Badge(Model.Status)">@Display.Text(Model.Status)</span></h1><div class="text-muted">@Model.RegistrationNumber · @Display.Text(Model.Type)</div></div>@if (canEdit) { <div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Изменить</a> <a asp-action="CreateMaintenance" asp-route-vehicleId="@Model.Id" class="btn btn-outline-success">План ТО</a> <a asp-action="CreateRepair" asp-route-vehicleId="@Model.Id" class="btn btn-outline-danger">Ремонт</a></div> }</div>
<div class="card card-body mb-3"><dl class="row"><dt class="col-sm-3">Водитель</dt><dd class="col-sm-9">@(Model.Driver?.FullName ?? "Не закреплён")</dd><dt class="col-sm-3">Пробег</dt><dd class="col-sm-9">@Model.Mileage.ToString("N0") км</dd><dt class="col-sm-3">Моточасы</dt><dd class="col-sm-9">@Model.EngineHours.ToString("N0") ч</dd><dt class="col-sm-3">Следующее ТО</dt><dd class="col-sm-9">@(Model.NextMaintenanceDate.HasValue ? Display.Date(Model.NextMaintenanceDate.Value) : "—"); @(Model.NextMaintenanceMileage?.ToString("N0")) км; @(Model.NextMaintenanceEngineHours?.ToString("N0")) ч</dd></dl></div>
<h2 class="h5">Техническое обслуживание</h2><div class="card table-responsive mb-4"><table class="table mb-0"><thead><tr><th>Дата</th><th>Работы</th><th>Статус</th><th>Стоимость</th><th>Действия</th></tr></thead><tbody>@foreach (var item in Model.MaintenanceRecords) { <tr><td>@Display.Date(item.PlannedDate)</td><td>@item.Description</td><td>@Display.Text(item.Status)</td><td>@Display.Money(item.Cost)</td><td>@if (canEdit && item.Status == MaintenanceStatus.Planned) { <form asp-action="StartMaintenance" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-warning">Начать</button></form> }@if (canEdit && item.Status == MaintenanceStatus.InProgress) { <form asp-action="CompleteMaintenance" method="post" class="row g-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><div class="col"><input name="cost" value="@item.Cost" class="form-control form-control-sm" title="Стоимость" /></div><div class="col"><input name="notes" class="form-control form-control-sm" placeholder="Примечание" /></div><div class="col"><input name="nextDate" type="date" class="form-control form-control-sm" /></div><div class="col-auto"><button class="btn btn-sm btn-success">Завершить</button></div></form> }</td></tr> }</tbody></table></div>
<h2 class="h5">Ремонты</h2><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Начат</th><th>Описание</th><th>Запчасти</th><th>Стоимость</th><th>Завершение</th></tr></thead><tbody>@foreach (var item in Model.Repairs) { <tr><td>@Display.DateTime(item.StartedAtUtc)</td><td>@item.Description</td><td>@item.Parts</td><td>@Display.Money(item.Cost)</td><td>@if (item.CompletedAtUtc.HasValue) { @Display.DateTime(item.CompletedAtUtc.Value) } else if (canEdit) { <form asp-action="CompleteRepair" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input name="cost" value="@item.Cost" class="form-control form-control-sm" /><input name="parts" value="@item.Parts" class="form-control form-control-sm" /><button class="btn btn-sm btn-success">Завершить</button></form> }</td></tr> }</tbody></table></div>
