@model MaintenanceInputModel
@{ ViewData["Title"] = "Планирование ТО"; }<h1>Планирование ТО</h1><form method="post" class="card card-body col-lg-6">@Html.AntiForgeryToken()<input asp-for="VehicleId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Description" class="form-label required"></label><input asp-for="Description" class="form-control" /></div><div class="mb-3"><label asp-for="PlannedDate" class="form-label"></label><input asp-for="PlannedDate" type="date" class="form-control" /></div><div class="mb-3"><label asp-for="Cost" class="form-label"></label><input asp-for="Cost" class="form-control" /></div><button class="btn btn-primary">Запланировать</button> <a asp-action="Details" asp-route-id="@Model.VehicleId" class="btn btn-link">Отмена</a></form>
