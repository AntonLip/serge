@model WorkOrder
@{ ViewData["Title"] = "Печать наряда"; }
<button onclick="window.print()" class="btn btn-success no-print mb-3">Печать / сохранить в PDF</button><div class="card card-body"><h1 class="h3">Производственный наряд @Model.Number</h1><p>Заявка: @Model.ServiceRequest.Number</p><hr /><p><strong>Объект:</strong> @Model.ServiceRequest.Object.Name, @Model.ServiceRequest.Object.Address</p><p><strong>Работы:</strong> @Model.ServiceRequest.Description</p><p><strong>Бригада:</strong> @Model.Crew.Name; @string.Join(", ", Model.Crew.Members.Select(x => x.FullName))</p><p><strong>Срок:</strong> @Display.DateTime(Model.PlannedStartUtc) — @Display.DateTime(Model.PlannedEndUtc)</p><p><strong>Техника:</strong> @string.Join(", ", Model.Vehicles.Select(x => x.Vehicle.Name + " " + x.Vehicle.RegistrationNumber))</p><p><strong>Примечания:</strong> @Model.Notes</p>@if (Model.Report is not null) { <hr /><h2 class="h4">Акт выполненных работ</h2><p>Работы завершены: @Display.DateTime(Model.Report.CompletedAtUtc)</p><p>Фактический объём: @Model.Report.ActualVolume; трудозатраты: @Model.Report.LaborHours чел.-ч; материалы: @Display.Money(Model.Report.MaterialsCost).</p><p>@Model.Report.Comment</p> }<div class="row mt-5"><div class="col">Диспетчер: ________________</div><div class="col">Бригадир: ________________</div></div><p class="small text-muted mt-4">Демонстрационная печатная форма.</p></div>
