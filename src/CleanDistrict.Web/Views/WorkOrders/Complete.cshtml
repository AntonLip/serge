@model WorkReportInputModel
@{ ViewData["Title"] = "Отчёт о выполнении"; }
<h1>Завершение наряда @ViewBag.OrderNumber</h1><form method="post" enctype="multipart/form-data" class="card card-body col-lg-7">@Html.AntiForgeryToken()<input asp-for="WorkOrderId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="ActualVolume" class="form-label required"></label><input asp-for="ActualVolume" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="LaborHours" class="form-label"></label><input asp-for="LaborHours" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="MaterialsCost" class="form-label"></label><input asp-for="MaterialsCost" class="form-control" /></div></div>
<div class="mb-3"><label asp-for="Comment" class="form-label required"></label><textarea asp-for="Comment" class="form-control" rows="4"></textarea></div><div class="mb-3"><label class="form-label">Фотографии «до/после» (до 5 файлов JPG/PNG)</label><input type="file" name="photos" multiple accept=".jpg,.jpeg,.png" class="form-control" />@Html.ValidationMessage("photos", new { @class = "text-danger" })</div><div><button class="btn btn-success">Сохранить отчёт</button> <a asp-action="Details" asp-route-id="@Model.WorkOrderId" class="btn btn-link">Отмена</a></div></form>
