@model WorkOrderInputModel
@{ ViewData["Title"] = "Новый наряд"; }
<h1>Наряд по заявке @ViewBag.RequestNumber</h1><form method="post" class="card card-body col-lg-8">@Html.AntiForgeryToken()<input asp-for="ServiceRequestId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="CrewId" class="form-label required"></label><select asp-for="CrewId" asp-items="ViewBag.Crews" class="form-select"><option value="">Выберите бригаду</option></select><span asp-validation-for="CrewId" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="PlannedStartLocal" class="form-label"></label><input asp-for="PlannedStartLocal" type="datetime-local" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="PlannedEndLocal" class="form-label"></label><input asp-for="PlannedEndLocal" type="datetime-local" class="form-control" /><span asp-validation-for="PlannedEndLocal" class="text-danger"></span></div></div>
<div class="mb-3"><label asp-for="VehicleIds" class="form-label"></label><select asp-for="VehicleIds" asp-items="ViewBag.Vehicles" class="form-select" multiple size="6"></select><div class="form-text">Для ручных работ технику можно не выбирать. Водитель назначается по закреплению за машиной.</div><span asp-validation-for="VehicleIds" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div><div><button class="btn btn-primary">Создать наряд</button> <a asp-controller="Requests" asp-action="Details" asp-route-id="@Model.ServiceRequestId" class="btn btn-link">Отмена</a></div></form>
