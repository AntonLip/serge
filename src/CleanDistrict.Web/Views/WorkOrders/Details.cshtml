@model WorkOrder
@{ ViewData["Title"] = "Наряд " + Model.Number; var canOperate = User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.CrewLeader); }
<div class="page-header"><div><h1>@Model.Number</h1><div class="text-muted">Заявка @Model.ServiceRequest.Number · @Display.Text(Model.Status)</div></div><a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Печать</a></div>
<div class="row g-3"><div class="col-lg-8"><div class="card card-body"><dl class="row"><dt class="col-sm-4">Объект</dt><dd class="col-sm-8">@Model.ServiceRequest.Object.Name, @Model.ServiceRequest.Object.Address</dd><dt class="col-sm-4">Клиент</dt><dd class="col-sm-8">@Model.ServiceRequest.Object.Client.Name</dd><dt class="col-sm-4">Работы</dt><dd class="col-sm-8">@Model.ServiceRequest.Description</dd><dt class="col-sm-4">Бригада</dt><dd class="col-sm-8">@Model.Crew.Name (@Model.Crew.Specialization)</dd><dt class="col-sm-4">Состав</dt><dd class="col-sm-8">@string.Join(", ", Model.Crew.Members.Select(x => x.FullName))</dd><dt class="col-sm-4">План</dt><dd class="col-sm-8">@Display.DateTime(Model.PlannedStartUtc) — @Display.DateTime(Model.PlannedEndUtc)</dd><dt class="col-sm-4">Примечания</dt><dd class="col-sm-8">@Model.Notes</dd></dl><h2 class="h6">Техника и водители</h2>@if (Model.Vehicles.Count == 0) { <p class="text-muted">Ручные работы без спецтехники.</p> } else { <table class="table"><tbody>@foreach (var item in Model.Vehicles) { <tr><td>@item.Vehicle.Name · @item.Vehicle.RegistrationNumber</td><td>@item.Driver.FullName</td></tr> }</tbody></table> }</div></div>
<div class="col-lg-4">@if (canOperate) { <div class="card card-body"><h2 class="h6">Выполнение</h2>@if (Model.Status == WorkOrderStatus.Planned) { <form asp-action="Start" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-success w-100">Начать работы</button></form> }@if (Model.Status == WorkOrderStatus.InProgress) { <a asp-action="Complete" asp-route-id="@Model.Id" class="btn btn-success w-100">Завершить и отчитаться</a> }@if (Model.Status == WorkOrderStatus.Completed) { <p class="text-success">Работы завершены @Display.DateTime(Model.ActualEndUtc!.Value)</p> }</div> }</div></div>
@if (Model.Report is not null) { <div class="card card-body mt-3"><h2 class="h5">Отчёт о работах</h2><dl class="row"><dt class="col-sm-3">Объём</dt><dd class="col-sm-9">@Model.Report.ActualVolume</dd><dt class="col-sm-3">Трудозатраты</dt><dd class="col-sm-9">@Model.Report.LaborHours чел.-ч</dd><dt class="col-sm-3">Материалы</dt><dd class="col-sm-9">@Display.Money(Model.Report.MaterialsCost)</dd><dt class="col-sm-3">Комментарий</dt><dd class="col-sm-9">@Model.Report.Comment</dd></dl>@foreach (var photo in Model.Report.Photos) { <a asp-action="Photo" asp-route-id="@photo.Id" class="btn btn-sm btn-outline-secondary">@photo.OriginalFileName</a> }</div> }
