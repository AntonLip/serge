@model EstimateInputModel
@{ ViewData["Title"] = "Новый расчёт"; }
<h1>Расчёт стоимости услуги</h1><form method="post" class="card card-body col-lg-8">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-7 mb-3"><label asp-for="ObjectId" class="form-label required"></label><select asp-for="ObjectId" asp-items="ViewBag.Objects" class="form-select"><option value="">Выберите объект</option></select></div><div class="col-md-5 mb-3"><label asp-for="TariffId" class="form-label required"></label><select asp-for="TariffId" asp-items="ViewBag.Tariffs" class="form-select"><option value="">Выберите тариф</option></select></div></div>
<div class="row"><div class="col-md-3 mb-3"><label asp-for="Area" class="form-label"></label><input asp-for="Area" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="CrewHours" class="form-label"></label><input asp-for="CrewHours" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="VehicleHours" class="form-label"></label><input asp-for="VehicleHours" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="MaterialsCost" class="form-label"></label><input asp-for="MaterialsCost" class="form-control" /></div></div>
<div class="form-check mb-3"><input asp-for="IsUrgent" class="form-check-input" /><label asp-for="IsUrgent" class="form-check-label"></label></div><div><button class="btn btn-primary">Рассчитать и сохранить</button> <a asp-action="Index" class="btn btn-link">Отмена</a></div></form>
