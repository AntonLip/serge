@model List<CostEstimate>
@{ ViewData["Title"] = "Расчёты стоимости"; }
<div class="page-header"><h1>Расчёты стоимости</h1>@if (!User.IsInRole(AppRoles.Director)) { <a asp-action="Create" class="btn btn-primary">Новый расчёт</a> }</div>
<div class="card table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Дата</th><th>Объект</th><th>Клиент</th><th>Тариф</th><th>Итого с НДС</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@Display.DateTime(item.CreatedAtUtc)</td><td><a asp-action="Details" asp-route-id="@item.Id">@item.Object.Name</a></td><td>@item.Object.Client.Name</td><td>@item.Tariff.Name</td><td>@Display.Money(item.Total)</td></tr> }</tbody></table></div>
