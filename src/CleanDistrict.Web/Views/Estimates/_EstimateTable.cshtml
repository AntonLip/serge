@model CostEstimate
<p><strong>Клиент:</strong> @Model.Object.Client.Name<br /><strong>Объект:</strong> @Model.Object.Name, @Model.Object.Address<br /><strong>Услуга:</strong> @Model.Tariff.Name</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Позиция</th><th>Количество</th><th>Ед.</th><th>Цена</th><th>Сумма</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Description</td><td>@item.Quantity.ToString("N2")</td><td>@item.Unit</td><td>@item.UnitPrice.ToString("N2")</td><td>@item.Amount.ToString("N2")</td></tr> }</tbody><tfoot><tr><th colspan="4">Без НДС</th><th>@Display.Money(Model.Subtotal)</th></tr><tr><th colspan="4">НДС (@Model.VatRate%)</th><th>@Display.Money(Model.VatAmount)</th></tr><tr><th colspan="4">Итого</th><th>@Display.Money(Model.Total)</th></tr></tfoot></table></div>
