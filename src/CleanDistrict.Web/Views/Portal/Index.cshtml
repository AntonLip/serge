@model List<ServiceRequest>
@{ ViewData["Title"] = "Мои заявки"; }
<div class="page-header"><div><h1>Мои заявки</h1><p class="text-muted mb-0">@ViewBag.ClientName</p></div><a asp-action="Create" class="btn btn-primary">Создать заявку</a></div>
<div class="card table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Номер</th><th>Объект</th><th>Создана</th><th>Желаемый срок</th><th>Стоимость</th><th>Статус</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Number</a></td><td>@item.Object.Name</td><td>@Display.DateTime(item.CreatedAtUtc)</td><td>@Display.DateTime(item.DesiredDateUtc)</td><td>@Display.Money(item.EstimatedCost)</td><td><span class="badge @Display.Badge(item.Status)">@Display.Text(item.Status)</span></td></tr>
}
</tbody></table></div>
@if (Model.Count == 0) { <div class="card card-body mt-3 text-muted">Заявок пока нет. Создайте первую заявку для объекта вашей организации.</div> }
