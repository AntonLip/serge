@model Client
@{ ViewData["Title"] = Model.Name; var canEdit = User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Administrator); }
<div class="page-header"><div><h1>@Model.Name</h1><div class="text-muted">@Model.ContactName · @Model.Phone · @Model.Email</div></div>@if (canEdit) { <div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Редактировать</a> <a asp-action="CreateObject" asp-route-clientId="@Model.Id" class="btn btn-primary">Добавить объект</a></div> }</div>
<h2 class="h5">Обслуживаемые объекты</h2><div class="card table-responsive mb-4"><table class="table mb-0"><thead><tr><th>Объект</th><th>Адрес</th><th>Площадь</th><th>Менеджер</th><th></th></tr></thead><tbody>@foreach (var item in Model.Objects) { <tr><td>@item.Name</td><td>@item.Address</td><td>@item.AreaSquareMeters.ToString("N0") м²</td><td>@item.Manager.FullName</td><td class="text-end">@if (canEdit) { <a asp-action="EditObject" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a> } <a asp-controller="Requests" asp-action="Index" asp-route-objectId="@item.Id" class="btn btn-sm btn-outline-success">Заявки</a></td></tr> }</tbody></table></div>
<h2 class="h5">Договоры</h2><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Номер</th><th>Период</th><th>Сумма</th><th>Статус</th></tr></thead><tbody>@foreach (var item in Model.Contracts) { <tr><td><a asp-controller="Contracts" asp-action="Details" asp-route-id="@item.Id">@item.Number</a></td><td>@Display.Date(item.StartDate) — @Display.Date(item.EndDate)</td><td>@Display.Money(item.TotalAmount)</td><td>@Display.Text(item.Status)</td></tr> }</tbody></table></div>
