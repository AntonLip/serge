@model Employee
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="FullName" class="form-label">ФИО</label><input asp-for="FullName" class="form-control" /></div><div class="mb-3"><label asp-for="Position" class="form-label">Должность</label><input asp-for="Position" class="form-control" /></div><div class="mb-3"><label asp-for="Phone" class="form-label">Телефон</label><input asp-for="Phone" class="form-control" /></div><div class="mb-3"><label class="form-label">Бригада</label><select asp-for="CrewId" asp-items="ViewBag.Crews" class="form-select"><option value="">Не входит в бригаду</option></select></div>
