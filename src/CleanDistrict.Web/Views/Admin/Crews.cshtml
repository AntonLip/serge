@model List<Crew>
@{ ViewData["Title"] = "Бригады"; }<div class="page-header"><h1>Бригады</h1><a asp-action="CreateCrew" class="btn btn-primary">Новая бригада</a></div><div class="row g-3">@foreach (var item in Model) { <div class="col-md-4"><div class="card card-body h-100"><h2 class="h5">@item.Name</h2><p class="text-muted">@item.Specialization</p><p>@string.Join(", ", item.Members.Select(x => x.FullName))</p><p>@(item.IsActive ? "Активна" : "Неактивна")</p><div><a asp-action="EditCrew" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a><form asp-action="ToggleCrew" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Деактивировать" : "Активировать")</button></form></div></div></div> }</div>
