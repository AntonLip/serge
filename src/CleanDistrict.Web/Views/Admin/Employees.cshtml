@model List<Employee>
@{ ViewData["Title"] = "Сотрудники"; }<div class="page-header"><h1>Сотрудники</h1><a asp-action="CreateEmployee" class="btn btn-primary">Новый сотрудник</a></div><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>ФИО</th><th>Должность</th><th>Телефон</th><th>Бригада</th><th>Состояние</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.FullName</td><td>@item.Position</td><td>@item.Phone</td><td>@item.Crew?.Name</td><td>@(item.IsActive ? "Активен" : "Неактивен")</td><td><a asp-action="EditEmployee" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a><form asp-action="ToggleEmployee" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Деактивировать" : "Активировать")</button></form></td></tr> }</tbody></table></div>
