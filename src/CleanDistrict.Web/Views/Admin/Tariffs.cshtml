@model List<Tariff>
@{ ViewData["Title"] = "Тарифы"; }<div class="page-header"><h1>Тарифы</h1><a asp-action="CreateTariff" class="btn btn-primary">Новый тариф</a></div><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Услуга</th><th>Тип</th><th>База</th><th>За м²</th><th>Бригада/ч</th><th>Техника/ч</th><th>НДС</th><th>Состояние</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.ServiceType</td><td>@item.BasePrice</td><td>@item.AreaRate</td><td>@item.CrewHourlyRate</td><td>@item.VehicleHourlyRate</td><td>@item.VatRate%</td><td>@(item.IsActive ? "Активен" : "Неактивен")</td><td class="text-end"><a asp-action="EditTariff" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a><form asp-action="ToggleTariff" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Деактивировать" : "Активировать")</button></form></td></tr> }</tbody></table></div>
