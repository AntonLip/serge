@model Tariff
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Name" class="form-label">Название</label><input asp-for="Name" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="ServiceType" class="form-label">Вид работ</label><input asp-for="ServiceType" class="form-control" /></div><div class="col-md-2 mb-3"><label asp-for="Unit" class="form-label">Единица</label><input asp-for="Unit" class="form-control" /></div></div><div class="row"><div class="col-md-3 mb-3"><label asp-for="BasePrice" class="form-label">Базовая цена</label><input asp-for="BasePrice" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="AreaRate" class="form-label">Ставка за м²</label><input asp-for="AreaRate" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="CrewHourlyRate" class="form-label">Бригада, ₽/ч</label><input asp-for="CrewHourlyRate" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="VehicleHourlyRate" class="form-label">Техника, ₽/ч</label><input asp-for="VehicleHourlyRate" class="form-control" /></div></div><div class="row"><div class="col-md-4 mb-3"><label asp-for="MaterialCost" class="form-label">Материалы</label><input asp-for="MaterialCost" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="UrgencyCoefficient" class="form-label">Коэффициент срочности</label><input asp-for="UrgencyCoefficient" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="VatRate" class="form-label">НДС, %</label><input asp-for="VatRate" class="form-control" /></div></div>
