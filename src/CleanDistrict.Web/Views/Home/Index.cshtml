@model DashboardViewModel
@{ ViewData["Title"] = "Рабочая панель"; }
<div class="page-header"><div><h1>Рабочая панель</h1><div class="text-muted">Оперативные показатели компании</div></div>@if (User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Dispatcher) || User.IsInRole(AppRoles.Administrator)) { <a asp-controller="Requests" asp-action="Create" class="btn btn-success">Новая заявка</a> }</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-2"><div class="card metric-card card-body"><span class="text-muted">Новые заявки</span><span class="metric">@Model.NewRequests</span></div></div>
    <div class="col-sm-6 col-xl-2"><div class="card metric-card card-body"><span class="text-muted">Просрочено</span><span class="metric text-danger">@Model.OverdueRequests</span></div></div>
    <div class="col-sm-6 col-xl-2"><div class="card metric-card card-body"><span class="text-muted">Активные наряды</span><span class="metric">@Model.ActiveWorkOrders</span></div></div>
    <div class="col-sm-6 col-xl-2"><div class="card metric-card card-body"><span class="text-muted">Техника доступна</span><span class="metric">@Model.AvailableVehicles</span></div></div>
    <div class="col-sm-6 col-xl-2"><div class="card metric-card card-body"><span class="text-muted">Ближайшее ТО</span><span class="metric">@Model.DueMaintenance</span></div></div>
    <div class="col-sm-6 col-xl-2"><div class="card metric-card card-body"><span class="text-muted">Договоры ≤ 30 дней</span><span class="metric">@Model.ExpiringContracts</span></div></div>
</div>
<div class="card"><div class="card-header bg-white d-flex justify-content-between"><strong>Последние заявки</strong><a asp-controller="Requests" asp-action="Index">Все заявки</a></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Номер</th><th>Объект</th><th>Клиент</th><th>Срок</th><th>Статус</th></tr></thead><tbody>
@foreach (var request in Model.RecentRequests) { <tr><td><a asp-controller="Requests" asp-action="Details" asp-route-id="@request.Id">@request.Number</a></td><td>@request.Object.Name</td><td>@request.Object.Client.Name</td><td>@Display.DateTime(request.DesiredDateUtc)</td><td><span class="badge @Display.Badge(request.Status)">@Display.Text(request.Status)</span></td></tr> }
</tbody></table></div></div>
