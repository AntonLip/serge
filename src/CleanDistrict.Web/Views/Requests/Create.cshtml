@model RequestInputModel
@{ ViewData["Title"] = "Новая заявка"; }
<h1>Новая заявка</h1><form method="post" class="card card-body col-lg-8">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-7 mb-3"><label asp-for="ObjectId" class="form-label required"></label><select asp-for="ObjectId" asp-items="ViewBag.Objects" class="form-select"><option value="">Выберите объект</option></select></div><div class="col-md-5 mb-3"><label asp-for="TariffId" class="form-label required"></label><select asp-for="TariffId" asp-items="ViewBag.Tariffs" class="form-select"><option value="">Выберите услугу</option></select></div></div>
<div class="mb-3"><label asp-for="CostEstimateId" class="form-label">Сохранённый расчёт (необязательно)</label><select asp-for="CostEstimateId" asp-items="ViewBag.Estimates" class="form-select"><option value="">Без расчёта</option></select></div>
<div class="mb-3"><label asp-for="Description" class="form-label required"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option value="0">Обычная</option><option value="1">Высокий</option><option value="2">Аварийная</option></select></div><div class="col-md-4 mb-3"><label asp-for="DesiredDateLocal" class="form-label required"></label><input asp-for="DesiredDateLocal" type="datetime-local" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="EstimatedCost" class="form-label"></label><input asp-for="EstimatedCost" class="form-control" /></div></div>
<div><button class="btn btn-primary">Зарегистрировать</button> <a asp-action="Index" class="btn btn-link">Отмена</a></div></form>
