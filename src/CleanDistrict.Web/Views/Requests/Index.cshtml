@model PagedList<ServiceRequest>
@{ ViewData["Title"] = "Заявки"; }
<div class="page-header"><h1>Диспетчерская · заявки</h1>@if (User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Dispatcher) || User.IsInRole(AppRoles.Administrator)) { <a asp-action="Create" class="btn btn-primary">Новая заявка</a> }</div>
<form method="get" class="row g-2 mb-3"><div class="col-md-2"><select name="status" asp-items="ViewBag.Statuses" class="form-select"><option value="">Все статусы</option></select></div><div class="col-md-2"><select name="priority" asp-items="ViewBag.Priorities" class="form-select"><option value="">Любой приоритет</option></select></div><div class="col-md-2"><select name="source" asp-items="ViewBag.Sources" class="form-select"><option value="">Любой источник</option></select></div><div class="col-md-2"><select name="objectId" asp-items="ViewBag.Objects" class="form-select"><option value="">Все объекты</option></select></div><div class="col-md-2 form-check ms-2 mt-2"><input class="form-check-input" type="checkbox" name="overdue" value="true" checked="@ViewBag.Overdue" /><label class="form-check-label">Просроченные</label></div><div class="col-auto"><button class="btn btn-outline-secondary">Применить</button></div></form>
<div class="card table-responsive" id="requests-table"><table class="table table-hover mb-0"><thead><tr><th>Номер</th><th>Объект / клиент</th><th>Услуга</th><th>Источник</th><th>Приоритет</th><th>Срок</th><th>Стоимость</th><th>Статус</th></tr></thead><tbody>
@foreach (var item in Model)
{
    var late = item.DesiredDateUtc < DateTime.UtcNow && item.Status is not RequestStatus.Completed and not RequestStatus.Closed and not RequestStatus.Cancelled;
    <tr class="@(late ? "table-danger" : "")"><td><a asp-action="Details" asp-route-id="@item.Id">@item.Number</a></td><td>@item.Object.Name<br /><small class="text-muted">@item.Object.Client.Name</small></td><td>@(item.Tariff?.Name ?? item.RequestedService ?? "Не назначена")</td><td><span class="badge @(item.Source == RequestSource.Client ? "text-bg-light" : "text-bg-secondary")">@Display.Text(item.Source)</span></td><td>@Display.Text(item.Priority)</td><td>@Display.DateTime(item.DesiredDateUtc)</td><td>@Display.Money(item.EstimatedCost)</td><td><span class="badge @Display.Badge(item.Status)">@Display.Text(item.Status)</span></td></tr>
}
</tbody></table></div><partial name="_Pagination" model="Model" />
@section Scripts { <script src="~/lib/signalr/signalr.min.js"></script><script>if (window.signalR) { const c = new signalR.HubConnectionBuilder().withUrl('/hubs/dispatch').build(); c.on('RequestChanged', () => window.location.reload()); c.start().catch(console.error); }</script> }
