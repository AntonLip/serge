@model List<ClientUserListItemViewModel>
@{ ViewData["Title"] = "Доступ клиентов"; }
<div class="page-header"><div><h1>Доступ клиентов</h1><p class="text-muted mb-0">Учётные записи для подачи заявок от организаций</p></div><a asp-action="Create" class="btn btn-primary">Выдать доступ</a></div>
<div class="table-responsive card"><table class="table table-hover mb-0"><thead><tr><th>Организация</th><th>ФИО</th><th>Email</th><th>Состояние</th><th></th></tr></thead><tbody>
@foreach (var user in Model)
{
    <tr><td>@user.ClientName</td><td>@user.FullName</td><td>@user.Email</td><td>@(user.IsLockedOut ? "Заблокирован" : "Активен")</td><td class="text-end"><form asp-action="ToggleLockout" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.Id" /><button class="btn btn-sm btn-outline-secondary">@(user.IsLockedOut ? "Разблокировать" : "Заблокировать")</button></form></td></tr>
}
</tbody></table></div>
@if (Model.Count == 0) { <div class="card card-body mt-3 text-muted">Клиентским учётным записям пока не выдан доступ.</div> }
