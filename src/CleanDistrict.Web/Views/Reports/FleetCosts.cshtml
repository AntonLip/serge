@model List<FleetCostRow>
@{ ViewData["Title"] = "Затраты на автопарк"; }<div class="page-header"><h1>Затраты на автопарк</h1><a asp-action="ExportFleetCosts" class="btn btn-outline-success">Экспорт CSV</a></div><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Техника</th><th>Номер</th><th>ТО</th><th>Ремонты</th><th>Итого</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.VehicleName</td><td>@item.RegistrationNumber</td><td>@Display.Money(item.MaintenanceCost)</td><td>@Display.Money(item.RepairCost)</td><td>@Display.Money(item.Total)</td></tr> }</tbody><tfoot><tr><th colspan="4">Итого</th><th>@Display.Money(Model.Sum(x => x.Total))</th></tr></tfoot></table></div>
