@model List<ObjectReportRow>
@{ ViewData["Title"] = "Работы по объектам"; }<div class="page-header"><h1>Работы по объектам</h1><a asp-action="ExportObjects" class="btn btn-outline-success">Экспорт CSV</a></div><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Объект</th><th>Клиент</th><th>Заявок</th><th>Выполнено</th><th>Стоимость</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.ObjectName</td><td>@item.ClientName</td><td>@item.RequestCount</td><td>@item.CompletedCount</td><td>@Display.Money(item.TotalCost)</td></tr> }</tbody></table></div>
