@model ResourceReportViewModel
@{ ViewData["Title"] = "Загрузка ресурсов"; }<h1>Загрузка ресурсов</h1><div class="row g-3"><div class="col-lg-6"><h2 class="h5">Бригады</h2><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Бригада</th><th>Нарядов</th><th>Завершено</th><th>Плановые часы</th></tr></thead><tbody>@foreach (var item in Model.Crews) { <tr><td>@item.CrewName</td><td>@item.OrderCount</td><td>@item.CompletedCount</td><td>@item.PlannedHours</td></tr> }</tbody></table></div></div><div class="col-lg-6"><h2 class="h5">Техника</h2><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Техника</th><th>Назначений</th><th>Плановые часы</th></tr></thead><tbody>@foreach (var item in Model.Vehicles) { <tr><td>@item.VehicleName<br /><small>@item.RegistrationNumber</small></td><td>@item.AssignmentCount</td><td>@item.PlannedHours</td></tr> }</tbody></table></div></div></div>
