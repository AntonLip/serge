@model ReportsIndexViewModel
@{ ViewData["Title"] = "Отчёты"; }<h1>Отчёты и показатели</h1><div class="row g-3 mb-4"><div class="col-md-3"><div class="card metric-card card-body"><span class="text-muted">Всего заявок</span><span class="metric">@Model.TotalRequests</span></div></div><div class="col-md-3"><div class="card metric-card card-body"><span class="text-muted">Выполнено</span><span class="metric">@Model.CompletedRequests</span></div></div><div class="col-md-3"><div class="card metric-card card-body"><span class="text-muted">В срок</span><span class="metric">@Model.OnTimePercent%</span></div></div><div class="col-md-3"><div class="card metric-card card-body"><span class="text-muted">Затраты автопарка</span><span class="metric">@Display.Money(Model.FleetCosts)</span></div></div></div><div class="list-group col-lg-7"><a asp-action="Requests" class="list-group-item list-group-item-action">Заявки за период <span class="text-muted">— детализация, сроки, стоимость, CSV</span></a><a asp-action="Objects" class="list-group-item list-group-item-action">Работы по объектам <span class="text-muted">— объёмы по клиентам, CSV</span></a><a asp-action="Resources" class="list-group-item list-group-item-action">Загрузка бригад и техники <span class="text-muted">— наряды и плановые часы</span></a><a asp-action="FleetCosts" class="list-group-item list-group-item-action">Затраты на автопарк <span class="text-muted">— ТО, ремонты, CSV</span></a></div><div class="card card-body mt-4 col-lg-7">Расчётная стоимость всех неотменённых заявок: <strong>@Display.Money(Model.EstimatedRevenue)</strong></div>
