@model PagedList<Contract>
@{ ViewData["Title"] = "Договоры"; }
<div class="page-header"><h1>Договоры</h1>@if (User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Administrator)) { <a asp-action="Create" class="btn btn-primary">Новый договор</a> }</div>
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Номер или клиент" /></div><div class="col-md-3"><select name="status" asp-items="ViewBag.Statuses" class="form-select"><option value="">Все статусы</option></select></div><div class="col-auto"><button class="btn btn-outline-secondary">Применить</button></div></form>
<div class="card table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Номер</th><th>Клиент</th><th>Период</th><th>Сумма</th><th>Статус</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Number</a></td><td>@item.Client.Name</td><td>@Display.Date(item.StartDate) — @Display.Date(item.EndDate)</td><td>@Display.Money(item.TotalAmount)</td><td>@Display.Text(item.Status)</td></tr> }</tbody></table></div><partial name="_Pagination" model="Model" />
