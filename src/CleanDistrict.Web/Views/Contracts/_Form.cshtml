@model Contract
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-5 mb-3"><label asp-for="Number" class="form-label required">Номер</label><input asp-for="Number" class="form-control" /><span asp-validation-for="Number" class="text-danger"></span></div><div class="col-md-7 mb-3"><label class="form-label required">Клиент</label><select asp-for="ClientId" asp-items="ViewBag.Clients" class="form-select"><option value="">Выберите клиента</option></select></div></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="StartDate" class="form-label">Дата начала</label><input asp-for="StartDate" type="date" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="EndDate" class="form-label">Дата окончания</label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Status" class="form-label">Статус</label><select asp-for="Status" class="form-select"><option value="0">Черновик</option><option value="1">Действует</option><option value="2">Истёк</option><option value="3">Закрыт</option></select></div></div>
<div class="mb-3"><label asp-for="TotalAmount" class="form-label">Сумма, ₽</label><input asp-for="TotalAmount" class="form-control" /></div>
<div class="mb-3"><label asp-for="Services" class="form-label required">Перечень услуг</label><textarea asp-for="Services" class="form-control" rows="4"></textarea></div>
<div class="mb-3"><label class="form-label">Скан договора (PDF, JPG, PNG, до 10 МБ)</label><input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />@Html.ValidationMessage("file", new { @class = "text-danger" })</div>
