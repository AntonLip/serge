@model Contract
@{ ViewData["Title"] = "Договор " + Model.Number; }
<button onclick="window.print()" class="btn btn-success no-print mb-3">Печать / сохранить в PDF</button>
<div class="card card-body"><h1 class="h3 text-center">Договор на оказание услуг @Model.Number</h1><p class="text-center">ООО «Чистый округ»</p><hr /><p><strong>Заказчик:</strong> @Model.Client.Name</p><p><strong>Адрес:</strong> @Model.Client.Address</p><p><strong>Контактное лицо:</strong> @Model.Client.ContactName, @Model.Client.Phone</p><p><strong>Срок действия:</strong> с @Display.Date(Model.StartDate) по @Display.Date(Model.EndDate).</p><h2 class="h5 mt-4">Перечень услуг</h2><p style="white-space:pre-line">@Model.Services</p><p><strong>Общая стоимость:</strong> @Display.Money(Model.TotalAmount).</p><p class="small text-muted mt-4">Демонстрационная печатная форма. Не является юридически значимым документом.</p><div class="row mt-5"><div class="col">Исполнитель: ________________</div><div class="col">Заказчик: ________________</div></div></div>
