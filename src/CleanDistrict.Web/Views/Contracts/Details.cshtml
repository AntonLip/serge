@model Contract
@{ ViewData["Title"] = "Договор " + Model.Number; }
<div class="page-header"><h1>Договор @Model.Number</h1><div><a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Печать</a>@if (User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Administrator)) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактировать</a> }</div></div>
<div class="card card-body col-lg-8"><dl class="row"><dt class="col-sm-4">Клиент</dt><dd class="col-sm-8"><a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId">@Model.Client.Name</a></dd><dt class="col-sm-4">Период</dt><dd class="col-sm-8">@Display.Date(Model.StartDate) — @Display.Date(Model.EndDate)</dd><dt class="col-sm-4">Статус</dt><dd class="col-sm-8">@Display.Text(Model.Status)</dd><dt class="col-sm-4">Сумма</dt><dd class="col-sm-8">@Display.Money(Model.TotalAmount)</dd><dt class="col-sm-4">Услуги</dt><dd class="col-sm-8">@Model.Services</dd>@if (Model.StoredFileName is not null) { <dt class="col-sm-4">Скан</dt><dd class="col-sm-8"><a asp-action="Download" asp-route-id="@Model.Id">@Model.OriginalFileName</a></dd> }</dl></div>
