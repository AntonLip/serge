@model dynamic
@if (Model.TotalPages > 1) { <nav class="mt-3"><ul class="pagination pagination-sm"><li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="?page=@(Model.Page - 1)">Назад</a></li><li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li><li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="?page=@(Model.Page + 1)">Вперёд</a></li></ul></nav> }
